<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Flamingle.App</RootNamespace>
    <AssemblyName>flamingle</AssemblyName>
    <Product>Flamingle</Product>
    <Company>Flamingle</Company>
    <Description>Group windows so they minimise, restore, move and relaunch together.</Description>
    <Version>0.1.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Per-monitor DPI aware (v2): every coordinate Flamingle reads or writes is in physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from flamingle.svg by tools/gen-icons.ps1 — don't edit the rasters by hand. -->
    <ApplicationIcon>Assets\flamingle.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Embedded for Settings → Changelog and the post-update "what's new" window (read back by this logical name). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Flamingle.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flamingle.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flamingle.Core\Flamingle.Core.csproj" />
  </ItemGroup>

</Project>
