<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Flamingle.App</RootNamespace>
    <AssemblyName>flamingle</AssemblyName>
    <Product>Flamingle</Product>
    <Company>Flamingle</Company>
    <Description>Group windows so they minimise, restore, move and relaunch together.</Description>
    <Version>0.2.1</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Per-monitor DPI aware (v2): every coordinate Flamingle reads or writes is in physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from flamingle.svg by tools/gen-icons.ps1 — don't edit the rasters by hand. -->
    <ApplicationIcon>Assets\flamingle.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Size: a self-contained publish trims the framework down to what's used (exe 40 MB → ~15 MB). Persisted types
       are source-generated (Core's FlamingleJson) since trimming turns off reflection JSON. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Native/ uses classic [ComImport] interop, which trimming switches off by default. Our assembly is rooted
         (below) so those interfaces keep every member and their vtable order, which is what IL2050 warns about. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <NoWarn>$(NoWarn);IL2050</NoWarn>
    <!-- Built-in COM also keeps the framework's COM *server* activator, which the trimmer always warns about (IL2026)
         and we never use. So publish-time trim warnings stay warnings; our own code is still held to warnings-as-errors
         by the trim analyzer at build time (here and in Core, which is IsTrimmable). -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="flamingle" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Embedded for Settings → Changelog and the post-update "what's new" window (read back by this logical name). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Flamingle.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flamingle.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <!-- The installer (release.yml packs it with vpk, pinned to this version in .config/dotnet-tools.json). -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flamingle.Core\Flamingle.Core.csproj" />
  </ItemGroup>

</Project>
